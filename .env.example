# 复制成 .env 后按需改。.env 已在 .gitignore 里，不会进仓库。

# 本地 docker compose 起的 MySQL（见 docker-compose.yml，映射在宿主 3307）
DATABASE_URL=mysql://tokenmp:tokenmp-dev@127.0.0.1:3307/tokenmp

# 会话签名密钥。生成一个：openssl rand -hex 32
# 生产环境必须换掉，否则启动时会直接报错。
SESSION_SECRET=change-me

# 转发内核（记录摄入、客户端密钥校验）的共享密钥（请求头 x-callback-secret）。生产必须设置
RECORDS_CALLBACK_SECRET=change-me

# 充值渠道回调的共享密钥（请求头 x-callback-secret）。生产必须设置，否则回调接口拒绝服务
RECHARGE_CALLBACK_SECRET=change-me
